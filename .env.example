# Same MongoDB Atlas cluster/database the Import Service writes to
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net
MONGODB_DB_NAME=aunqa

# Same ChromaDB server the Import Service writes embeddings to
CHROMA_HOST=localhost
CHROMA_PORT=8001
CHROMA_COLLECTION=evidence_chunks

# Gemini API key. GEMINI_EMBEDDING_MODEL MUST match the Import Service's
# GEMINI_EMBEDDING_MODEL exactly - query vectors and stored vectors have to
# come from the same embedding model or similarity search is meaningless.
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_CRITERIA_MODEL=gemini-flash-lite-latest
GEMINI_EMBEDDING_MODEL=models/gemini-embedding-001

# Master Config JSON (criterion order, keywords, evidence requirements)
MASTER_CONFIG_PATH=./master_config.json

# Where the completed SAR .docx is written
OUTPUT_DIR=./output

# Retrieval
EVIDENCE_TOP_K=6

# Verification gates
RAPIDFUZZ_THRESHOLD=80
SEMANTIC_SIMILARITY_THRESHOLD=0.45
SENTENCE_TRANSFORMER_MODEL=paraphrase-multilingual-MiniLM-L12-v2
MAX_VERIFICATION_RETRIES=3

# Testing only - nudges the Criteria Agent to write best-effort content from
# available Evidence instead of defaulting to gap_analysis=missing when a
# criterion's guideline/required_evidence are empty (pending real Evidence).
# Set back to false (or remove) once real Evidence is in place - see
# README.md's "Guideline lives in master_config.json" section.
TEST_MODE_FORCE_CONTENT=false

# api_server.py only - origin(s) allowed to call it (the Import Service
# frontend's "Generate SAR" page). Not used by the CLI (master_agent.master).
CORS_ORIGINS=http://localhost:5173
